# Ignore node_modules in both frontend and backend
frontend/node_modules/
backend/node_modules/

# Ignore build and dist folders
frontend/build/
backend/dist/

# Ignore environment files (sensitive data)
frontend/.env
backend/.env

# Ignore logs
frontend/logs/
backend/logs/
*.log

# Ignore cache files
frontend/.next/
backend/.cache/

# Ignore IDE settings and OS files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
